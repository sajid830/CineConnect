
# ==============================================================================
# CineConnect Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` before running the application.
#
# IMPORTANT:
# - Never commit `.env` containing real credentials.
# - `.env` is excluded through the root .gitignore.
# - Keep this file as a shared template with placeholder values.
# ==============================================================================

# ==============================================================================
# Application Environment
# ==============================================================================
# Options: local | development | staging | production
APP_ENV=local

# Application Metadata
APP_NAME=CineConnect
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Logging Level
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# CORS Configuration
# Comma-separated list of allowed origins.
# Update with exact frontend origins when required.
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,http://10.0.2.2:8000

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=cineconnect
POSTGRES_PASSWORD=your_local_password_here
POSTGRES_DB=cineconnect_db
POSTGRES_TEST_DB=cineconnect_test_db

# Docker Compose service name and internal PostgreSQL port.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# Asynchronous Database Connection URL
# ==============================================================================
# Docker Compose:
# FastAPI connects to PostgreSQL using the Docker service name.
#
# Format:
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE

DATABASE_URL=postgresql+asyncpg://cineconnect:your_local_password_here@postgres:5432/cineconnect_db
TEST_DATABASE_URL=postgresql+asyncpg://cineconnect:your_local_password_here@localhost:5433/cineconnect_test_db

# ==============================================================================
# Database Connection Pool Settings
# ==============================================================================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# Docker Host Port Configuration
# ==============================================================================
# Windows PostgreSQL already uses port 5432.
# Docker PostgreSQL will be accessible from Windows on port 5433.
# PostgreSQL remains on port 5432 inside Docker.
#
# This variable is used by docker-compose.yml for host port mapping.
POSTGRES_HOST_PORT=5433

# ==============================================================================
# Mobile Frontend API Connectivity Guide
# ==============================================================================

# 1. Android Emulator:
#    API_BASE_URL=http://10.0.2.2:8000
#    flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000

# 2. Physical Android Device (same Wi-Fi network):
#    API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8000

# 3. iOS Simulator:
#    API_BASE_URL=http://127.0.0.1:8000

# 4. Future Cloud Production:
#    API_BASE_URL=https://api.cineconnect.app

# ==============================================================================
# End of CineConnect Environment Configuration
# ==============================================================================

# ==============================================================================
# Supabase Authentication & Services
# ==============================================================================
# Project URL used for JWT issuer and JWKS public key resolution.
SUPABASE_URL=https://your-project-id.supabase.co

# Active JWT signing algorithm: ES256 (ECC P-256 asymmetric) or RS256 / HS256.
SUPABASE_JWT_ALGORITHM=ES256

# Note:
# - SUPABASE_JWKS_URL is automatically derived: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# - SUPABASE_JWT_ISSUER is automatically derived: {SUPABASE_URL}/auth/v1
# - Asymmetric algorithms (ES256, RS256) verify tokens via public JWKS without backend API keys.
# - SUPABASE_JWT_SECRET is only required for legacy symmetric HS256 verification, if retained.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ==============================================================================
# Media Storage (MinIO / S3)
# ==============================================================================
# Pinned MinIO image tag used by Docker Compose
MINIO_IMAGE=minio/minio:RELEASE.2026-11-16T00-11-40Z
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Root credentials for MinIO server
MINIO_ACCESS_KEY=your-minio-access-key-here
MINIO_SECRET_KEY=your-minio-secret-key-here
MINIO_REGION=us-east-1
MINIO_USE_SSL=false

# Buckets segregation
MINIO_PUBLIC_BUCKET=cineconnect-public
MINIO_PRIVATE_BUCKET=cineconnect-private
MINIO_BUCKET_NAME=cineconnect-public
# Retained for legacy/backward compatibility (defaults to public bucket)
MINIO_BUCKET=cineconnect-public

# Internal MinIO endpoint for server-to-storage operations:
# - Inside Docker Compose: http://minio:9000
# - Outside Docker / Local test runner: http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://localhost:9000

# Client-reachable public MinIO endpoint for direct mobile / browser uploads:
# - Web / Localhost: http://localhost:9000
# - Android Emulator: http://10.0.2.2:9000
# - Physical Android Device: http://<YOUR_DEVELOPMENT_PC_LAN_IP>:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ==============================================================================
# Cache & Broker (Redis)
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
