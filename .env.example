# ==============================================================================
# CineConnect Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` before running the application:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit `.env` containing sensitive credentials to version control.
# - Ensure `.env` is listed in your `.gitignore`.
# ==============================================================================

# Application Environment
# Options: local | development | staging | production
APP_ENV=local

# Application Metadata
APP_NAME=CineConnect
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Logging Level
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ==============================================================================
# CORS Configuration
# Comma-separated list of allowed origins.
# For local dev: include localhost and common dev ports.
# In production: replace with exact production frontend/app domains.
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,http://10.0.2.2:8000

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=cineconnect
POSTGRES_PASSWORD=cineconnect_secret_password_change_me
POSTGRES_DB=cineconnect_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==============================================================================
# Asynchronous Database Connection URL
# Driver: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
#
# 1. When running backend inside Docker Compose:
#    DATABASE_URL=postgresql+asyncpg://cineconnect:cineconnect_secret_password_change_me@postgres:5432/cineconnect_db
#
# 2. When running backend directly on host machine (outside Docker):
#    DATABASE_URL=postgresql+asyncpg://cineconnect:cineconnect_secret_password_change_me@localhost:5432/cineconnect_db
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://cineconnect:cineconnect_secret_password_change_me@postgres:5432/cineconnect_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# Mobile Frontend API Connectivity Guide
# ==============================================================================
# 1. Android Emulator (accessing host machine backend):
#    API_BASE_URL=http://10.0.2.2:8000
#    Run Flutter with: flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# 2. Physical Android Device (over same Wi-Fi / Local Area Network):
#    Replace with your computer's local LAN IP (e.g., 192.168.1.50):
#    API_BASE_URL=http://192.168.x.x:8000
#    Run Flutter with: flutter run --dart-define=API_BASE_URL=http://192.168.x.x:8000
#
# 3. iOS Simulator:
#    API_BASE_URL=http://127.0.0.1:8000
#
# 4. Future Cloud Production:
#    API_BASE_URL=https://api.cineconnect.app
# ==============================================================================
