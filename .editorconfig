# EditorConfig helps maintain consistent coding styles across IDEs
# See: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyw}]
indent_size = 4

[*.{dart}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
